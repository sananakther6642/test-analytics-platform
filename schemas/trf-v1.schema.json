{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://test-analytics-platform/schemas/trf-v1.schema.json",
  "title": "Test Run Format (TRF) v1",
  "description": "Synthetic, invented test-report format for the Test Analytics Platform. Not modeled on any real company's format.",
  "type": "object",
  "required": ["run_id", "suite_name", "git_sha", "branch", "started_at", "finished_at", "environment", "tests"],
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Unique identifier for this test run."
    },
    "suite_name": {
      "type": "string",
      "description": "Name of the test suite that produced this run."
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$",
      "description": "Commit SHA the suite ran against. Used for same-commit flaky detection."
    },
    "branch": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "string",
      "description": "Where the suite ran, e.g. 'ci', 'local', 'staging'."
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["test_id", "name", "file", "status", "duration_ms"],
        "properties": {
          "test_id": {
            "type": "string",
            "description": "Stable identifier for this test, consistent across renames if possible."
          },
          "name": { "type": "string" },
          "file": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "skipped", "error"]
          },
          "duration_ms": {
            "type": "number",
            "minimum": 0
          },
          "retries": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "failure_message": {
            "type": ["string", "null"]
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          }
        }
      }
    }
  }
}
